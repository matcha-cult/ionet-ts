{
  "name": "@nbb-ionet/extension-nestjs",
  "version": "0.1.0",
  "description": "ionet NestJS integration — Module, Provider, Action auto-registration",
  "author": "NbbJack",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nbb-ionet/common-kit": "workspace:*",
    "@nbb-ionet/core-framework": "workspace:*",
    "@nbb-ionet/external-server": "workspace:*",
    "@nbb-ionet/logic-server": "workspace:*",
    "@nbb-ionet/redis": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@swc/core": "^1.5.0",
    "@types/ws": "^8.18.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "ws": "^8.21.0"
  }
}
