{
  "name": "@nbb-ionet/client-protocol",
  "version": "0.1.0",
  "description": "ionet browser-safe protocol package — envelope types, JSON codec with forward-compatible unknown-field passthrough, reqId/FIFO response association, kind dispatch (PROTOCOL.md compliant, zero Node dependencies)",
  "author": "NbbJack",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "browser": "./dist/testing.js",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@swc/core": "^1.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
